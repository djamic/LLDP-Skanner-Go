# network's MAC->IP inventory when the process dies before the rename)
*.tmp
scan_results.json
graphs_data.txt
debug_*.txt
debug_edges_analysis.log
scanner_pid.txt
zabbix_hosts.json
zabbix_map.json
captures/
influxdb/
mermaid_images/
results/*
!results/*.md
!results/*.sh

# Logs and editor backups
*.log
*.bak
*.backup

# Generated documents
*.docx

