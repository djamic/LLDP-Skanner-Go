secrets/
bot/.bot_token
bot/.api_token
bot/admin_data.json

# Build outputs and binaries
lldp_scanner
snmp_scanner
export/lldp_scanner
*.tar
*.tar.gz

# Python environments and caches
bot/venv/
__pycache__/
*.pyc

# Runtime data written by the scanner (large, changes every cycle)
network_data.json
mac_ip_cache.json
mac_ip_cache_seen.json
modules_inventory.json
